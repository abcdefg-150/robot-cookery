-# TODO
+"""Deterministic bounded pose IK for custom URDF chains."""
+
+import xml.etree.ElementTree as ET
+import numpy as np
+from scipy.optimize import least_squares
+from scipy.spatial.transform import Rotation
+
+
+class URDFPoseIK:
+    def __init__(self, urdf_path, base_link, ee_link, joint_names):
+        root = ET.parse(urdf_path).getroot()
+        parents = {j.find("child").get("link"): j for j in root.findall("joint")}
+        chain = []
+        link = ee_link
+        while link != base_link:
+            joint = parents[link]
+            chain.append(joint)
+            link = joint.find("parent").get("link")
+        self.chain = []
+        self.joint_names = list(joint_names)
+        limits = {}
+        for joint in reversed(chain):
+            origin = joint.find("origin")
+            transform = np.eye(4)
+            if origin is not None:
+                transform[:3, 3] = np.fromstring(origin.get("xyz", "0 0 0"), sep=" ")
+                transform[:3, :3] = Rotation.from_euler("xyz", np.fromstring(origin.get("rpy", "0 0 0"), sep=" ")).as_matrix()
+            name = joint.get("name")
+            if joint.get("type") == "fixed":
+                self.chain.append((transform, None, None))
+            elif joint.get("type") == "revolute" and name in self.joint_names:
+                axis = np.fromstring(joint.find("axis").get("xyz"), sep=" ")
+                axis /= np.linalg.norm(axis)
+                self.chain.append((transform, self.joint_names.index(name), axis))
+                limit = joint.find("limit")
+                limits[name] = [float(limit.get("lower")), float(limit.get("upper"))]
+            else:
+                raise ValueError(f"Unsupported IK chain joint {name}")
+        bounds = np.asarray([limits[name] for name in self.joint_names])
+        self.lower, self.upper = bounds[:, 0], bounds[:, 1]
+
+    def forward(self, joints):
+        result = np.eye(4)
+        for origin, index, axis in self.chain:
+            result = result @ origin
+            if index is not None:
+                rotation = np.eye(4)
+                rotation[:3, :3] = Rotation.from_rotvec(axis * joints[index]).as_matrix()
+                result = result @ rotation
+        return result
+
+    def solve(self, position, quaternion_wxyz, current, accept=None, max_restarts=16):
+        target_rotation = Rotation.from_quat(np.asarray(quaternion_wxyz)[[1, 2, 3, 0]]).as_matrix()
+        def residual(joints):
+            pose = self.forward(joints)
+            return np.r_[pose[:3, 3] - position,
+                         Rotation.from_matrix(target_rotation.T @ pose[:3, :3]).as_rotvec()]
+        # Continue from the current branch first; random restarts are fixed for
+        # reproducibility and only used if continuation cannot reach the pose.
+        rng = np.random.default_rng(0)
+        seeds = [np.clip(current, self.lower + 1e-6, self.upper - 1e-6)]
+        seeds.extend(rng.uniform(self.lower + 1e-6, self.upper - 1e-6, (max_restarts, len(current))))
+        for seed in seeds:
+            result = least_squares(residual, seed, bounds=(self.lower, self.upper), max_nfev=180)
+            error = residual(result.x)
+            if np.linalg.norm(error[:3]) < 1e-4 and np.linalg.norm(error[3:]) < 1e-3:
+                if accept is None or accept(result.x):
+                    return result.x
+        return None
